# Base URL for the deployed site. Used for metadataBase, canonical URLs,
# sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://mythica.games

# Resend API key. Leave unset in local development — the contact route
# degrades gracefully and logs the message instead of sending.
RESEND_API_KEY=

# Verified sending address on your Resend domain, e.g.
# no-reply@send.mythica.games. Must be a domain you have verified in Resend —
# sending from a personal mailbox will fail SPF/DKIM and land in spam.
CONTACT_FROM_EMAIL=

# Comma-separated list of recipients for contact form submissions.
# Migrate to a real alias (e.g. hello@mythica.games via Cloudflare Email
# Routing) when the recipient roster stabilizes — no code change required.
CONTACT_TO_EMAIL=
